venv/
__pycache__/
.pytest_cache/
*.pyc
.env
.env.*
.DS_Store

# Generated datasets — regenerate with data/generator/generate_dataset.py
data/synthetic/

# Assessment outputs are generated artifacts, never source. The previous
# patterns only matched the top level, so anything written to a
# subdirectory (outputs/desktop_assessment/, which is where the desktop
# app writes) was still being picked up.
outputs/**
!outputs/.gitkeep

# Local assessment history (Phase 13) — per-run output directories.
assessments/

# Local AI models. A .gguf is 2-9 GB and is deployment media, not source.
*.gguf
*.bin
*.safetensors
models/
data/demo/

# Offline AI installation media assembled into the distributable
# package: a vendor installer and multi-gigabyte model weights. These
# belong on the distribution media, not in the repository.
packaging/ai/

# PyInstaller build artifacts.
build/
dist/
self-check.txt

# Windows packaging output. `build/` and `dist/` above cover a native
# Windows build; these are the paths used when cross-building under
# Wine on Linux, where the defaults would collide with a Linux build.
build-windows/
dist-windows/
outputs-win/

# The Windows distributable. Built in CI and attached to a GitHub
# release; it is never a file in the repository. ~76 MB zipped.
SAT-SA-Windows.zip
